# ---- Core ----
ENVIRONMENT=development
# DATABASE_URL=sqlite:///data/terratrace.db        # PostgreSQL: postgresql+psycopg://user:pass@host/db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=200

# ---- LLM: Ollama (default, local, free) ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434      # in Docker Compose use http://host.docker.internal:11434
OLLAMA_MODEL=                               # a TOOL-CAPABLE model you have pulled, e.g. qwen3:8b or llama3.1:8b

# ---- LLM: Grok / xAI (optional, paid API) ----
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1

# ---- Copernicus Data Space (Sentinel-2 downloads; search works without) ----
CDSE_USERNAME=
CDSE_PASSWORD=

# ---- Frontend (build time) ----
# VITE_API_BASE=https://your-backend.example.com/api
